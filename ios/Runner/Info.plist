<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Zapsafe Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>zapsafe_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- ─── Day 22 · iOS background processing ─────────────────── -->
	<!-- Identifiers the OS lets us register with BGTaskScheduler.
	     Must match BackgroundProcessingHandler.TASK_IDENTIFIER. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.zapsafe.dcs</string>
	</array>

	<!-- Background modes the app may operate under.
	     - processing      : BGProcessingTask (DCS pipeline)
	     - remote-notification : silent FCM watchdog push (Day 22)
	     - audio           : continuous audio capture (Day 26+)
	     - location        : background GPS during active SOS (Day 23+) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>remote-notification</string>
		<string>audio</string>
		<string>location</string>
	</array>

	<!-- ─── Day 22 · iOS usage-description strings ─────────────── -->
	<!-- iOS rejects apps that touch these APIs without explaining why.
	     Strings shown verbatim in system permission dialogs. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ZapSafe uses your microphone to capture audio evidence and detect the voice-trigger keyword during a safety event.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>ZapSafe shares your live location with your Tier 1 contacts while an SOS is active so they can find you quickly.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ZapSafe shares your live location with your Tier 1 contacts while an SOS is active so they can find you quickly.</string>
	<key>NSCameraUsageDescription</key>
	<string>ZapSafe captures video evidence and recognises the blink-code trigger during a safety event.</string>
	<key>NSMotionUsageDescription</key>
	<string>ZapSafe reads motion sensors to detect impacts and motion-based SOS triggers.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>ZapSafe uses Face ID to quickly and securely unlock your Evidence Vault.</string>
</dict>
</plist>
